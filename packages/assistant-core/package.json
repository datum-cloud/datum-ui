{
  "name": "@datum-cloud/datum-ui-assistant-core",
  "type": "module",
  "version": "0.1.0",
  "description": "Platform-free core of the Datum assistant (Patch): types, message reducers, SSE and A2A stream parsing, and the chat transport shared by the web and React Native UIs.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/datum-cloud/datum-ui",
    "directory": "packages/assistant-core"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "dev": "tsdown --config-loader native --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "peerDependencies": {
    "ai": ">=7 <8"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^24.10.1",
    "ai": "^7.0.66",
    "eslint": "^10.8.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
