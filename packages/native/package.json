{
  "name": "@datum-cloud/datum-ui-native",
  "version": "0.0.0",
  "description": "React Native components for the Datum design system.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/datum-cloud/datum-ui",
    "directory": "packages/native"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "dist",
    "fonts",
    "src"
  ],
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "node scripts/copy-assets.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.parity.json",
    "test": "node scripts/copy-assets.mjs && tsc --noEmit -p tsconfig.parity.json && jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist fonts assets .turbo node_modules coverage"
  },
  "peerDependencies": {
    "expo-haptics": ">=14",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.79",
    "react-native-reanimated": ">=4 <5",
    "react-native-svg": ">=15 <16"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "dependencies": {
    "@datum-cloud/datum-ui-assistant-core": "workspace:^",
    "@datum-cloud/datum-ui-tokens": "workspace:^",
    "react-native-marked": "8.3.2"
  },
  "devDependencies": {
    "@datum-cloud/datum-ui": "workspace:*",
    "@repo/config": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^10.8.1",
    "expo": "~57.0.27",
    "expo-haptics": "~57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "test-renderer": "~1.2.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
